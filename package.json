{
  "name": "scholarpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:auth": "bash tests/auth-mock/run-all.sh",
    "test:db": "bash tests/db/run-rls-tests.sh",
    "test:profile": "bash tests/profile/run-unit.sh",
    "test:profile-ui": "bash tests/profile/run-ui.sh",
    "test:documents": "bash tests/documents/run-unit.sh && node tests/documents/security-static.test.cjs",
    "test:documents-live": "node tests/documents/live-verify.mjs",
    "test:admin-scholarships": "bash tests/admin-scholarships/run-unit.sh && node tests/admin-scholarships/security-static.test.cjs",
    "test:search": "bash tests/search/run-unit.sh && node tests/search/security-static.test.cjs",
    "test:matching": "bash tests/matching/run-unit.sh && bash tests/matching/run-flow.sh && node tests/matching/security-static.test.cjs",
    "test:matching-ui": "bash tests/matching/run-ui.sh",
    "test:details": "bash tests/details/run-unit.sh && node tests/details/security-static.test.cjs",
    "test:knowledge": "bash tests/knowledge/run-unit.sh && node tests/knowledge/security-static.test.cjs",
    "test:assistant": "bash tests/assistant/run-unit.sh && node tests/assistant/security-static.test.cjs",
    "test:agent": "bash tests/agent/run-unit.sh && node tests/agent/security-static.test.cjs",
    "test:agent-mutation": "node tests/agent/mutation.test.cjs",
    "test:applications": "bash tests/applications/run-unit.sh && node tests/applications/security-static.test.cjs",
    "test:copilot": "bash tests/copilot/run-unit.sh && node tests/copilot/security-static.test.cjs",
    "test:review": "bash tests/review/run-unit.sh && node tests/review/security-static.test.cjs",
    "test:mentors": "bash tests/mentors/run-unit.sh && node tests/mentors/security-static.test.cjs",
    "test:admin": "bash tests/admin/run-unit.sh && node tests/admin/security-static.test.cjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
