# ScholarPath PK — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Supabase (public: safe for the browser; protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET: server-only, bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (SECRET: server-only) ---
# GEMINI_API_KEY is used by Module 11 (embeddings: gemini-embedding-001, 768 dims) and later by the AI modules.
# Never prefix AI keys with NEXT_PUBLIC_. Ingestion/retrieval also need SUPABASE_SERVICE_ROLE_KEY (server-only).
GEMINI_API_KEY=
# Optional (Module 12): overrides the default answer-generation model. Plain model id only; unverified default, see HANDOFF.
# GEMINI_GENERATION_MODEL=
GROK_API_KEY=

# --- App settings ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
